@model List<ContabilitaAccertamentiViewModel>

@{
    ViewData["Title"] = "Contabilità Accertamenti";
}

<h1>Contabilità Accertamenti</h1>

<form asp-action="Index" method="get">
    <div class="row mb-3">
        <div class="col">
            <label for="meseAnno">Mese/Anno:</label>
            <input type="text" name="meseAnno" id="meseAnno" class="form-control"
                   placeholder="AAAA-MM o AAAA" value="@ViewData["MeseAnno"]">
        </div>
        <div class="col">
            <label for="codCor">Codice Correlato (CodCor):</label>
            <select name="codCor" class="form-control" asp-items="ViewBag.CodCorOptions">
                <option value="">-- Seleziona Codice Correlato --</option>
            </select>
        </div>
        <div class="col">
            <label for="tipoAccertamento">Tipo Accertamento:</label>
            <select name="tipoAccertamento" class="form-control" asp-items="ViewBag.TipoAccertamentoOptions">
                <option value="">-- Seleziona Tipo Accertamento --</option>
            </select>
        </div>
        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-outline-primary me-2" aria-label="Filtra risultati" title="Filtra">
                <i class="bi bi-funnel-fill"></i>
            </button>
            <button type="submit" formaction="@Url.Action("ResetFiltri")" formmethod="post" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Servizio</th>
            <th>Totale Accertamenti</th>
            <th>Totale Accertamenti Ritornati</th>
            <th>Totale Accertamenti Mancanti</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Servizio</td>
                <td>@item.TotaleAccertamenti</td>
                <td>@item.TotaleAccertamentiRitornati</td>
                <td>@item.TotaleAccertamentiMancanti</td>
            </tr>
        }
    </tbody>
</table>
