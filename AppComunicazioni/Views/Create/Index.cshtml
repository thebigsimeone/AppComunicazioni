@model AppComunicazioni.Models.DTO_s.ComunicazioniDTO
@{
    ViewData["Title"] = "Crea";
}

<h1>Crea</h1>

<h4>Comunicazione</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-floating mb-3">
                <input asp-for="FileName" class="form-control" id="FileName" placeholder="Nome file">
                <label asp-for="FileName">Nome file</label>
                <span asp-validation-for="FileName" class="text-danger"></span>
            </div>

            <!-- Data di Arrivo -->
            <div class="mb-3 position-relative">
                <div class="input-group">
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="document.getElementById('DateA').showPicker();" title="Seleziona data">
                        <i class="bi bi-calendar"></i>
                    </button>
                    <div class="form-floating flex-grow-1">
                        <input asp-for="DateA" type="datetime-local" class="form-control" id="DateA" placeholder="Data di arrivo">
                        <label asp-for="DateA">Data di arrivo</label>
                    </div>
                </div>
            </div>

            <!-- Data di Fine Smarco -->
            <div class="mb-3 position-relative">
                <div class="input-group">
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="document.getElementById('DateF').showPicker();" title="Seleziona data">
                        <i class="bi bi-calendar"></i>
                    </button>
                    <div class="form-floating flex-grow-1">
                        <input asp-for="DateF" type="datetime-local" class="form-control" id="DateF" placeholder="Data di fine smarco">
                        <label asp-for="DateF">Data di fine smarco</label>
                    </div>
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="NProtocol" type="number" class="form-control" id="NProtocol" placeholder="Numero di protocolli" min="0">
                <label asp-for="NProtocol">Numero di protocolli</label>
                <span asp-validation-for="NProtocol" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="NsProtocol" type="number" class="form-control" id="NsProtocol" placeholder="Protocolli da rivedere" min="0">
                <label asp-for="NsProtocol">Protocolli da rivedere</label>
                <span asp-validation-for="NsProtocol" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <select asp-for="Servizio" class="form-control" asp-items="ViewBag.ServizioOptions">
                    <option value="">-- Seleziona Servizio --</option>
                </select>
                <label asp-for="Servizio">Servizio</label>
                <span asp-validation-for="Servizio" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <textarea asp-for="Note" class="form-control" id="Note" placeholder="Note" style="height: 100px;"></textarea>
                <label asp-for="Note">Note</label>
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="ExcelFile">Carica File Excel (opzionale):</label>
                <input type="file" class="form-control" id="ExcelFile" name="ExcelFile" accept=".xlsx">
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-outline-primary">Crea</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Indietro</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).on('submit', 'form', function () {
            $(this).find(':submit').prop('disabled', true);
            $('body').append('<div class="spinner-border" role="status"><span class="sr-only"></span></div>');
        });
    </script>
}
