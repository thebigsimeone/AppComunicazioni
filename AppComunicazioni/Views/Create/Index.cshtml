@model AppComunicazioni.Models.DTO_s.ComunicazioniDTO
@{
    ViewData["Title"] = "Crea";
}

<h1>Crea</h1>

<h4>Comunicazione</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-floating mb-3">
                <input asp-for="FileName" class="form-control" id="FileName" placeholder="Nome file">
                <label asp-for="FileName">Nome file</label>
                <span asp-validation-for="FileName" class="text-danger"></span>
            </div>

            <!-- Data di Arrivo -->
            <div class="form-floating mb-3 position-relative">
                <input asp-for="DateA" type="datetime-local" class="form-control input-with-icon" id="DateA" placeholder="Data di arrivo">
                <label asp-for="DateA" class="label-with-icon">Data di arrivo</label>
                <button type="button" class="btn btn-outline-secondary floating-button"
                        onclick="document.getElementById('DateA').showPicker();" title="Seleziona data">
                    <i class="bi bi-calendar-date"></i>
                </button>
            </div>

            <!-- Data di Fine Smarco -->
            <div class="form-floating mb-3 position-relative">
                <input asp-for="DateF" type="datetime-local" class="form-control input-with-icon" id="DateF" placeholder="Data di fine smarco">
                <label asp-for="DateF" class="label-with-icon">Data di fine smarco</label>
                <button type="button" class="btn btn-outline-secondary floating-button"
                        onclick="document.getElementById('DateF').showPicker();" title="Seleziona data">
                    <i class="bi bi-calendar-date"></i>
                </button>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="NProtocol" type="number" class="form-control" id="NProtocol" placeholder="Numero di protocolli" min="0">
                <label asp-for="NProtocol">Numero di protocolli</label>
                <span asp-validation-for="NProtocol" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="NsProtocol" type="number" class="form-control" id="NsProtocol" placeholder="Protocolli da rivedere" min="0">
                <label asp-for="NsProtocol">Protocolli da rivedere</label>
                <span asp-validation-for="NsProtocol" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <select asp-for="Servizio" class="form-control" asp-items="ViewBag.ServizioOptions">
                    <option value="">-- Seleziona Servizio --</option>
                </select>
                <label asp-for="Servizio">Servizio</label>
                <span asp-validation-for="Servizio" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <textarea asp-for="Note" class="form-control" id="Note" placeholder="Note" style="height: 100px;"></textarea>
                <label asp-for="Note">Note</label>
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="ExcelFile">Carica File Excel (opzionale):</label>
                <input type="file" class="form-control" id="ExcelFile" name="ExcelFile" accept=".xlsx">
            </div>

            <!-- Bottoni -->
            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-outline-primary" id="submitButton">Crea</button>
                <a href="@ViewContext.HttpContext.Request.Headers["Referer"]" class="btn btn-outline-secondary">Indietro</a>
            </div>
        </form>
    </div>
</div>

<!-- Toast Notification -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer">
    <div id="toastMessage" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="toastBody" data-message="@TempData["Message"]">
                <!-- Messaggio gestito tramite dataset -->
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
}

