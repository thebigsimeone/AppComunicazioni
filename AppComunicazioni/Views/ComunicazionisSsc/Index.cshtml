@model ComunicazioniViewModel

@{
    ViewData["Title"] = "Comunicazioni";
}

<h1>Comunicazioni SSC</h1>

<form asp-action="Index" method="get">
    <div class="row mb-3">
        <div class="col">
            <label for="searchTerm">Cerca File:</label>
            <input type="text" name="searchTerm" class="form-control" placeholder="Nome file" value="@(ViewData["SearchTerm"] ?? "")">
        </div>
        <div class="col">
            <label for="startDate">Da:</label>
            <input type="date" name="startDate" class="form-control" value="@(ViewData["StartDate"] ?? "")">
        </div>
        <div class="col">
            <label for="endDate">A:</label>
            <input type="date" name="endDate" class="form-control" value="@(ViewData["EndDate"] ?? "")">
        </div>
        <div class="col">
            <label for="monthYear">Mese/Anno:</label>
            <input type="month" name="monthYear" class="form-control" value="@(ViewData["MonthYear"] ?? "")">
        </div>
        <div class="col">
            <label for="codCor">Codice Correlato (CodCor):</label>
            <select name="codCor" class="form-control" asp-items="ViewBag.CodCorOptions">
                <option value="">-- Seleziona Codice Correlato --</option>
            </select>
        </div>
        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-outline-primary">Filtra</button>
            <button type="submit" formaction="@Url.Action("ResetFiltri")" formmethod="post" class="btn btn-outline-secondary">Reset Filtri</button>
        </div>
    </div>
</form>

<table class="table table-hover">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortField="FileName" asp-route-sortOrder="@(Model.SortField == "FileName" && Model.SortOrder == "asc" ? "desc" : Model.SortField == "FileName" && Model.SortOrder == "desc" ? "default" : "asc")">
                    @Html.DisplayNameFor(m => m.Comunicazioni.First().FileName)
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortField="DateA" asp-route-sortOrder="@(Model.SortField == "DateA" && Model.SortOrder == "asc" ? "desc" : Model.SortField == "DateA" && Model.SortOrder == "desc" ? "default" : "asc")">
                    @Html.DisplayNameFor(m => m.Comunicazioni.First().DateA)
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortField="DateF" asp-route-sortOrder="@(Model.SortField == "DateF" && Model.SortOrder == "asc" ? "desc" : Model.SortField == "DateF" && Model.SortOrder == "desc" ? "default" : "asc")">
                    @Html.DisplayNameFor(m => m.Comunicazioni.First().DateF)
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortField="NProtocol" asp-route-sortOrder="@(Model.SortField == "NProtocol" && Model.SortOrder == "asc" ? "desc" : Model.SortField == "NProtocol" && Model.SortOrder == "desc" ? "default" : "asc")">
                    @Html.DisplayNameFor(m => m.Comunicazioni.First().NProtocol)
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortField="NsProtocol" asp-route-sortOrder="@(Model.SortField == "NsProtocol" && Model.SortOrder == "asc" ? "desc" : Model.SortField == "NsProtocol" && Model.SortOrder == "desc" ? "default" : "asc")">
                    @Html.DisplayNameFor(m => m.Comunicazioni.First().NsProtocol)
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortField="Servizio" asp-route-sortOrder="@(Model.SortField == "Servizio" && Model.SortOrder == "asc" ? "desc" : Model.SortField == "Servizio" && Model.SortOrder == "desc" ? "default" : "asc")">
                    @Html.DisplayNameFor(m => m.Comunicazioni.First().Servizio)
                </a>
            </th>
            <th>Azioni</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Comunicazioni)
        {
            <tr>
                <td>
                    <a class="btn @(item.DateF == null ? "btn-outline-danger" : "btn-outline-info")" asp-action="Details" asp-route-id="@item.Id">@item.FileName</a>
                </td>
                <td>@item.DateA?.ToString("dd/MM/yyyy | HH:mm")</td>
                <td>@item.DateF?.ToString("dd/MM/yyyy | HH:mm")</td>
                <td>@item.NProtocol</td>
                <td>@item.NsProtocol</td>
                <td>@item.Servizio</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-primary">
                        <i class="bi bi-pencil-square"></i>
                    </a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">
                        <i class="bi bi-trash-fill"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
