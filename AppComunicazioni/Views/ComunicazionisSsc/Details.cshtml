@model AppComunicazioni.Models.DTO_s.ComunicazioniDTO

<h2>Dettagli Comunicazione</h2>
<div>
    <dl class="row">
        <dt class="col-sm-2">Nome file</dt>
        <dd class="col-sm-10">@Model.FileName</dd>
        <dt class="col-sm-2">Data di invio</dt>
        <dd class="col-sm-10">@Model.DateA?.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-2">Data di fine smarco</dt>
        <dd class="col-sm-10">@Model.DateF?.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-2">Numero protocolli</dt>
        <dd class="col-sm-10">@Model.NProtocol</dd>
        <dt class="col-sm-2">Protocolli da rivedere</dt>
        <dd class="col-sm-10">@Model.NsProtocol</dd>
        <dt class="col-sm-2">Servizio</dt>
        <dd class="col-sm-10">@Model.Servizio</dd>
    </dl>
</div>
<h3>Dettagli del File Caricato</h3>
@if (Model.Dettagli != null && Model.Dettagli.Any())
{
    <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#dettagliTable" aria-expanded="false" aria-controls="dettagliTable">
        Mostra/Nascondi Dettagli
    </button>
    <div class="collapse" id="dettagliTable">
        <table class="table table-striped mt-3">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Protocollo</th>
                    <th>Codice Fiscale</th>
                    <th>Colonna Supplementare</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowNumber = 1; 
                }
                @foreach (var dettaglio in Model.Dettagli)
                {
                    <tr>
                        <td>@rowNumber</td>
                        <td>@dettaglio.Protocollo</td>
                        <td>@dettaglio.CodiceFiscale</td>
                        <td>@dettaglio.ColonnaSupplementare</td>
                    </tr>
                    rowNumber++; // Incrementa il contatore
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>Nessun dettaglio disponibile per questa comunicazione.</p>
}
