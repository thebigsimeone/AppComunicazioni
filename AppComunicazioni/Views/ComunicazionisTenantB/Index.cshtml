@model ComunicazioniViewModel
@using AppComunicazioni.Interface
@using AppComunicazioni.Models
@using AppComunicazioni.Helpers

@{
    ViewData["Title"] = "Comunicazioni";
    var sortIcon = new Func<string, string, string>((field, order) =>
    {
        if (Model.SortField == field)
        {
            return order == "asc" ? "bi bi-caret-up-fill" : "bi bi-caret-down-fill";
        }
        return "bi bi-filter";
    });

    // Definisci dei valori predefiniti per evitare problemi con null
    var currentPage = Model.CurrentPage > 0 ? Model.CurrentPage : 1;
    var totalPages = Model.TotalPages > 0 ? Model.TotalPages : 1;
    var comunicazioni = Model.Comunicazioni ?? new List<Comunicazioni>();
    var sortField = Model.SortField ?? "DateA";
    var sortOrder = Model.SortOrder ?? "asc";
}

<div class="container-fluid px-4">
    <h1 class="mb-4 text-center" style="font-size: 1.5rem;">Comunicazioni TENANT_B</h1>
    
    <partial name="_Filters" model="Model" />

    <div class="table-responsive">
        <table class="table table-hover table-bordered text-center w-100">
            <partial name="_TableHeader" />
            <partial name="_TableRows" model="Model.Comunicazioni" />
        </table>
    </div>

    <partial name="_Pagination" model="Model" />

</div>

@functions {
    public string EncryptId(int id)
    {
        var encryptionService = (IEncryptionService)ViewContext.HttpContext.RequestServices.GetService(typeof(IEncryptionService));
        return encryptionService.Encrypt(id.ToString());
    }
}

