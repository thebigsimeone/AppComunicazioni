@model ComunicazioniViewModel
@using AppComunicazioni.Models

@{
    ViewData["Title"] = "Comunicazioni";
    var sortIcon = new Func<string, string, string>((field, order) =>
    {
        if (Model.SortField == field)
        {
            return order == "asc" ? "bi bi-caret-up-fill" : "bi bi-caret-down-fill";
        }
        return "bi bi-filter";
    });

    // Definisci dei valori predefiniti per evitare problemi con null
    var currentPage = Model.CurrentPage > 0 ? Model.CurrentPage : 1;
    var totalPages = Model.TotalPages > 0 ? Model.TotalPages : 1;
    var comunicazioni = Model.Comunicazioni ?? new List<Comunicazioni>();
    var sortField = Model.SortField ?? "DateA";
    var sortOrder = Model.SortOrder ?? "asc";
}

<div class="container-fluid px-4">
    <h1 class="mb-4 text-center" style="font-size: 1.5rem;">Comunicazioni EBI</h1>

    <form asp-action="Index" method="get" class="p-3 border rounded bg-light mb-4" style="font-size: 0.9rem;">
        <div class="row g-2 align-items-center">
            <!-- Search Term -->
            <div class="col-lg-3 col-md-4">
                <div class="input-group">
                    <label for="searchTerm" class="visually-hidden">Cerca per nome file o protocollo</label>
                    <span class="input-group-text"><i class="bi bi-search" title="Cerca"></i></span>
                    <input type="text" name="searchTerm" id="searchTerm" class="form-control" placeholder="Nome file o Protocollo" value="@(Model.SearchTerm ?? "")">
                </div>
            </div>

            <!-- Start Date -->
            <div class="col-lg-2 col-md-4">
                <div class="input-group">
                    <label for="startDate" class="visually-hidden">Data Inizio</label>
                    <span class="input-group-text"><i class="bi bi-calendar" title="Data di invio"></i></span>
                    <input type="date" name="startDate" id="startDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "")">
                </div>
            </div>

            <!-- End Date -->
            <div class="col-lg-2 col-md-4">
                <div class="input-group">
                    <label for="endDate" class="visually-hidden">Data Fine</label>
                    <span class="input-group-text"><i class="bi bi-calendar" title="Data di arrivo"></i></span>
                    <input type="date" name="endDate" id="endDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd") ?? "")">
                </div>
            </div>

            <!-- Month Year -->
            <div class="col-lg-2 col-md-4">
                <div class="input-group">
                    <label for="monthYear" class="visually-hidden">Mese e Anno</label>
                    <span class="input-group-text"><i class="bi bi-calendar2-month" title="Filtra per anno/mese"></i></span>
                    <input type="month" name="monthYear" id="monthYear" class="form-control" value="@(Model.MonthYear?.ToString("yyyy-MM") ?? "")">
                </div>
            </div>

            <!-- CodCor Select -->
            <div class="col-lg-2 col-md-4">
                <div class="input-group">
                    <label for="codCorSelect" class="visually-hidden">Seleziona Codice Correlato</label>
                    <span class="input-group-text"><i class="bi bi-list-task" title="Fornitore"></i></span>
                    <select id="codCorSelect" name="codCor" class="form-select" asp-items="ViewBag.CodCorOptions" onchange="updateServizioOptions()">
                        <option value="">-- Seleziona Codice Correlato --</option>
                    </select>
                </div>
            </div>

            <!-- Servizio Select -->
            <div class="col-lg-2 col-md-4">
                <div class="input-group">
                    <label for="servizioSelect" class="visually-hidden">Seleziona Servizio</label>
                    <span class="input-group-text"><i class="bi bi-list-task" title="Servizio"></i></span>
                    <select id="servizioSelect" name="servizio" class="form-select" asp-items="ViewBag.ServizioOptions">
                        <option value="">-- Seleziona Servizio --</option>
                    </select>
                </div>
            </div>

            <!-- Checkbox Solo Righe Non Restituite -->
            <div class="col-auto d-flex align-items-center">
                <div class="form-check">
                    <input type="checkbox" name="soloRigheNonRestituite" class="form-check-input" id="soloRigheNonRestituite"
                           value="true" @(Model.SoloRigheNonRestituite ? "checked" : "")>
                    <label class="form-check-label" for="soloRigheNonRestituite">Solo file non evasi</label>
                </div>
            </div>

            <!-- Buttons for Filter and Reset -->
            <div class="col-auto d-flex align-items-center">
                <button type="submit" class="btn btn-outline-primary me-2" aria-label="Filtra risultati" title="Filtra">
                    <i class="bi bi-funnel-fill"></i>
                </button>
                <button type="submit" formaction="@Url.Action("ResetFiltri")" formmethod="post" class="btn btn-outline-secondary" aria-label="Reimposta filtri" title="Reset Filtro">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover table-bordered text-center w-100">
            <thead class="table-info">
                <tr>
                    <th style="width: 14%;">
                        <a asp-action="Index" asp-route-sortField="FileName" asp-route-sortOrder="@(sortField == "FileName" && sortOrder == "asc" ? "desc" : "asc")" title="Nome File">
                            <i class="bi bi-file-earmark-text"></i>
                            <i class="@sortIcon("FileName", sortOrder)"></i>
                        </a>
                    </th>
                    <th style="width: 14%;">
                        <a asp-action="Index" asp-route-sortField="DateA" asp-route-sortOrder="@(sortField == "DateA" && sortOrder == "asc" ? "desc" : "asc")" title="Data di invio">
                            <i class="bi bi-calendar-plus"></i>
                            <i class="@sortIcon("DateA", sortOrder)"></i>
                        </a>
                    </th>
                    <th style="width: 14%;">
                        <a asp-action="Index" asp-route-sortField="DateF" asp-route-sortOrder="@(sortField == "DateF" && sortOrder == "asc" ? "desc" : "asc")" title="Data di arrivo">
                            <i class="bi bi-calendar-check"></i>
                            <i class="@sortIcon("DateF", sortOrder)"></i>
                        </a>
                    </th>
                    <th style="width: 14%;">
                        <a asp-action="Index" asp-route-sortField="NProtocol" asp-route-sortOrder="@(sortField == "NProtocol" && sortOrder == "asc" ? "desc" : "asc")" title="Totale protocolli">
                            <i class="bi bi-hash"></i>
                            <i class="@sortIcon("NProtocol", sortOrder)"></i>
                        </a>
                    </th>
                    <th style="width: 14%;">
                        <a asp-action="Index" asp-route-sortField="NsProtocol" asp-route-sortOrder="@(sortField == "NsProtocol" && sortOrder == "asc" ? "desc" : "asc")" title="Protocolli da controllare">
                            <i class="bi bi-exclamation-circle"></i>
                            <i class="@sortIcon("NsProtocol", sortOrder)"></i>
                        </a>
                    </th>
                    <th style="width: 14%;">
                        <a asp-action="Index" asp-route-sortField="Servizio" asp-route-sortOrder="@(sortField == "Servizio" && sortOrder == "asc" ? "desc" : "asc")" title="Servizio">
                            <i class="bi bi-gear-fill"></i>
                            <i class="@sortIcon("Servizio", sortOrder)"></i>
                        </a>
                    </th>
                    <th style="width: 16%;"><i class="bi bi-tools"></i></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in comunicazioni)
                {
                    <tr class="@(item.DateF == null ? "table-danger" : "table-light")">
                        <td style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            <a class="text-decoration-none fw-bold text-primary" asp-action="Details" asp-route-id="@item.Id">@item.FileName</a>
                        </td>
                        <td>@item.DateA?.ToString("dd/MM/yyyy | HH:mm")</td>
                        <td>@item.DateF?.ToString("dd/MM/yyyy | HH:mm")</td>
                        <td><span class="badge bg-info">@item.NProtocol</span></td>
                        <td><span class="badge bg-warning text-dark">@item.NsProtocol</span></td>
                        <td>@item.Servizio</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-2">
                                <i class="bi bi-trash-fill"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="d-flex justify-content-center mt-4">
        <ul class="pagination">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="1"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                   asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                   asp-route-codCor="@Model.CodCor"
                   asp-route-servizio="@Model.Servizio"
                   asp-route-monthYear="@Model.MonthYear?.ToString("yyyy-MM")"
                   asp-route-sortField="@Model.SortField"
                   asp-route-sortOrder="@Model.SortOrder"
                   asp-route-soloRigheNonRestituite="@Model.SoloRigheNonRestituite">
                    Prima
                </a>
            </li>
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(currentPage - 1)"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                   asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                   asp-route-codCor="@Model.CodCor"
                   asp-route-servizio="@Model.Servizio"
                   asp-route-monthYear="@Model.MonthYear?.ToString("yyyy-MM")"
                   asp-route-sortField="@Model.SortField"
                   asp-route-sortOrder="@Model.SortOrder"
                   asp-route-soloRigheNonRestituite="@Model.SoloRigheNonRestituite">
                    &laquo;
                </a>
            </li>
            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(currentPage + 2, totalPages); i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageNumber="@i"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                       asp-route-codCor="@Model.CodCor"
                       asp-route-servizio="@Model.Servizio"
                       asp-route-monthYear="@Model.MonthYear?.ToString("yyyy-MM")"
                       asp-route-sortField="@Model.SortField"
                       asp-route-sortOrder="@Model.SortOrder"
                       asp-route-soloRigheNonRestituite="@Model.SoloRigheNonRestituite">
                        @i
                    </a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(currentPage + 1)"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                   asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                   asp-route-codCor="@Model.CodCor"
                   asp-route-servizio="@Model.Servizio"
                   asp-route-monthYear="@Model.MonthYear?.ToString("yyyy-MM")"
                   asp-route-sortField="@Model.SortField"
                   asp-route-sortOrder="@Model.SortOrder"
                   asp-route-soloRigheNonRestituite="@Model.SoloRigheNonRestituite">
                    &raquo;
                </a>
            </li>
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@totalPages"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                   asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                   asp-route-codCor="@Model.CodCor"
                   asp-route-servizio="@Model.Servizio"
                   asp-route-monthYear="@Model.MonthYear?.ToString("yyyy-MM")"
                   asp-route-sortField="@Model.SortField"
                   asp-route-sortOrder="@Model.SortOrder"
                   asp-route-soloRigheNonRestituite="@Model.SoloRigheNonRestituite">
                    Ultima
                </a>
            </li>
        </ul>
    </nav>
</div>

<script>
    function updateServizioOptions() {
        const codCor = document.getElementById("codCorSelect").value;
        const servizioSelect = document.getElementById("servizioSelect");

        // Pulisce le opzioni precedenti
        servizioSelect.innerHTML = '<option value="">-- Seleziona Servizio --</option>';

        // Aggiunge nuove opzioni in base al CodCor selezionato
        let options = [];
        switch (codCor) {
            case "CESSIONI":
                options = ["BA2", "BAN", "CEP"];
                break;
            case "DATAVIZ":
                options = ["APP", "DIM", "DV", "ERE", "MA7", "MIM", "PDL", "S035", "VL1", "VLA", "VL3", "VPP", "VSA", "VSS"];
                break;
            case "FORZA":
                options = ["DP1", "VED"];
                break;
            default:
                options = [];
        }

        options.forEach(function(option) {
            const opt = document.createElement("option");
            opt.value = option;
            opt.text = option;
            servizioSelect.add(opt);
        });
    }
</script>
