@model AppComunicazioni.Models.Comunicazioni

@{
    ViewData["Title"] = "Elimina";
}

<h1>Elimina</h1>

<h3>Sei sicuro di voler eliminare la comunicazione?</h3>
<div>
    <h4>Comunicazioni</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FileName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FileName)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DateA)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DateA)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DateF)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DateF)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NProtocol)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NProtocol)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NsProtocol)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NsProtocol)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-outline-danger" /> |
        <a class="btn btn-outline-secondary" asp-action="Index">Indietro</a>
    </form>
</div>
