@model IEnumerable<AppComunicazioni.Models.Destinatari>
@using AppComunicazioni.Helpers
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Contatti";
}

<h1>Contatti</h1>

<p>
    <a class="btn btn-outline-primary" asp-action="Create">Inserisci nuovo contatto</a>
</p>

<table class="table table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Destinatario)</th>
            <th>@Html.DisplayNameFor(model => model.Attivo)</th>
            <th>@Html.DisplayNameFor(model => model.Smarchi)</th>
            <th>@Html.DisplayNameFor(model => model.Monitor)</th>
            <th>@Html.DisplayNameFor(model => model.Report)</th>
            <th>Azioni</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Destinatario)</td>
                <td>
                    @if (item.Attivo == "S")
                    {
                        <span class="badge bg-success">Attivo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Non Attivo</span>
                    }
                </td>
                <td>
                    @if (item.Smarchi == "S")
                    {
                        <span class="badge bg-info">Smarchi</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No Smarchi</span>
                    }
                </td>
                <td>
                    @if (item.Monitor == "S")
                    {
                        <span class="badge bg-info">Monitoraggio</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No Monitoraggio</span>
                    }
                </td>
                <td>
                    @if (item.Report == "S")
                    {
                        <span class="badge bg-warning">Report</span>
                    }
                    else
                    {
                        <span class="badge bg-light">No Report</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@Html.EncryptId(item.Id.ToString())" class="text-primary" title="Modifica">
                        <i class="bi bi-pencil-square"></i>
                    </a> |
                    <a asp-action="Details" asp-route-id="@Html.EncryptId(item.Id.ToString())" class="text-info" title="Dettagli">
                        <i class="bi bi-info-circle-fill"></i>
                    </a> |
                    <a asp-action="Delete" asp-route-id="@Html.EncryptId(item.Id.ToString())" class="text-danger" onclick="return confirm('Sei sicuro di voler eliminare questo destinatario?');" title="Elimina">
                        <i class="bi bi-trash-fill"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
