@model IEnumerable<AppComunicazioni.Models.Destinatari>
@using AppComunicazioni.Helpers

@{
    ViewData["Title"] = "Destinatari";
}

<h1>Destinatari</h1>

<p>
    <a class="btn btn-outline-primary" asp-action="Create">Inserisci nuovi destinatari</a>
</p>
<table class="table table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Destinatario)</th>
            <th>@Html.DisplayNameFor(model => model.Attivo)</th>
            <th>@Html.DisplayNameFor(model => model.Monitor)</th>
            <th>@Html.DisplayNameFor(model => model.Report)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Destinatario)</td>
                <td>@Html.DisplayFor(modelItem => item.Attivo)</td>
                <td>@Html.DisplayFor(modelItem => item.Monitor)</td>
                <td>@Html.DisplayFor(modelItem => item.Report)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@Html.EncryptId(item.Id.ToString())" class="text-primary">
                        <i class="bi bi-pencil-square"></i>
                    </a> |
                    <a asp-action="Details" asp-route-id="@Html.EncryptId(item.Id.ToString())" class="text-info">
                        <i class="bi bi-info-circle-fill"></i>
                    </a> |
                    <a asp-action="Delete" asp-route-id="@Html.EncryptId(item.Id.ToString())" class="text-danger">
                        <i class="bi bi-trash-fill"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
