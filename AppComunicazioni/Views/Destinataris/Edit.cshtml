@model AppComunicazioni.Models.DTO_s.DestinatariDTO

@{
    ViewData["Title"] = "Modifica";
}

<h1>Modifica</h1>

<h4>Destinatario</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-floating mb-3">
                <input asp-for="Destinatario" class="form-control" id="destinatario" placeholder="Destinatario">
                <label asp-for="Destinatario">Destinatario</label>
                <span asp-validation-for="Destinatario" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="attivo" name="Attivo" value="S" @(Model.Attivo == "S" ? "checked" : "") />
                <label class="form-check-label" for="attivo">Attivo</label>
                <span asp-validation-for="Attivo" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="monitor" name="Monitor" value="S" @(Model.Monitor == "S" ? "checked" : "") />
                <label class="form-check-label" for="monitor">Monitoraggio</label>
                <span asp-validation-for="Monitor" class="text-danger"></span>
            </div>

            <div class="form-group d-flex justify-content-between align-items-end">
                <button type="submit" class="btn btn-outline-primary">Salva</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Indietro</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
