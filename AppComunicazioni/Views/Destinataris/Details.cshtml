@model AppComunicazioni.Models.DTO_s.DestinatariDTO

@{
    ViewData["Title"] = "Dettaglio";
}

<h1>Dettaglio</h1>

<div>
    <h4>Destinatario</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Destinatario)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Destinatario)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Attivo)
        </dt>
        <dd class="col-sm-10">
            @(Model.Attivo == "S" ? "Attivo" : "Non Attivo")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Monitor)
        </dt>
        <dd class="col-sm-10">
            @(Model.Monitor == "S" ? "Attivo" : "Non Attivo")
        </dd>
    </dl>
</div>
<div>
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model?.Id">Modifica</a> |
    <a class="btn btn-outline-secondary" asp-action="Index">Indietro</a>
</div>
